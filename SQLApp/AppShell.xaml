<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SQLApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SQLApp.View"
    Title="SQLApp" FlyoutBehavior="Disabled">

    <ShellContent
        Title="Menu principal"
        ContentTemplate="{DataTemplate local:MenuPage}"
        Route="inicio" />
    <ShellContent Title="Clientes" ContentTemplate="{DataTemplate local:ClientesPage}" Route="clientes" />
    <ShellContent Title="Produtos" ContentTemplate="{DataTemplate local:ProdutosPage}" Route="produtos" />
    <ShellContent Title="Compras e Itens" ContentTemplate="{DataTemplate local:ComprasPage}" Route="compras" />

</Shell>
